# ─── Sessions ────────────────────────────────────────────────────────────────
# At least 32 characters. Signs the session cookie.
SESSION_SECRET=

# ─── Google sign in and calendar ─────────────────────────────────────────────
# One consent covers signing in and connecting the booking calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# At least 32 characters. Encrypts stored refresh tokens. Without it the server
# refuses to store one at all.
TOKEN_ENCRYPTION_KEY=

# ─── The agent that answers customers and writes posts ───────────────────────
# The ladder is tried left to right until one answers. Reordering it, or adding
# a provider, is a change here and nowhere in the code.
MODEL_PROVIDERS=groq,ollama

# Simple questions go to the light model, involved ones to the heavy one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b

# This machine, as the safety net. No key needed, just a pulled model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Ready for later. Add "anthropic" to MODEL_PROVIDERS to switch it on.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5-20251001

# One key, hundreds of models, and a free tier that costs nothing to start on.
# Both defaults below are free models, so leaving them alone spends nothing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_LIGHT_MODEL=openai/gpt-oss-20b:free
TOGETHER_API_KEY=
TOGETHER_MODEL=
CUSTOM_MODEL_URL=
CUSTOM_MODEL_KEY=
CUSTOM_MODEL=

# Optional. The existing FastAPI service the public chat used to call.
AI_BACKEND_URL=

# ─── Publishing ──────────────────────────────────────────────────────────────
# Platform level fallback. A workspace that connects its own account on the
# Connections screen uses that instead, and its posts never touch these.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://ai-flow-platform-v2-saas.onrender.com/api/social/callback/tiktok
# Protects the scheduler endpoint if something external calls it.
CRON_SECRET=

# ─── Payments ────────────────────────────────────────────────────────────────
# Card details are entered on Stripe's pages and never reach this server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=baskinltd@yahoo.com

# ─── Public identity ─────────────────────────────────────────────────────────
PUBLIC_SITE_URL=
COMPANY_LEGAL_NAME=
CONTACT_PHONE=
DEMO_VIDEO_URL=
# Optional. Forwards demo requests to an existing CRM or webhook.
DEMO_WEBHOOK_URL=
